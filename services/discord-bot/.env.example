# Discord
DISCORD_TOKEN=""
DISCORD_GUILD_ID=""

# MongoDB
# Hostname `kage` is the Mongo container on naruto-network.
# Do not use mongodb://kage:27017 after a password is set.
MONGO_HOST="kage"
MONGO_DATABASE="narutotcg"
MONGO_AUTH_SOURCE="admin"

# Official Mongo image reads these on FIRST boot of an empty volume.
# Generate a password: openssl rand -hex 24
# Use letters/numbers only so Compass does not need URL encoding.
MONGO_INITDB_ROOT_USERNAME="naruto"
MONGO_INITDB_ROOT_PASSWORD=""
MONGO_INITDB_DATABASE="narutotcg"

# Permissions
MESSAGE_MANAGER_ROLE_IDS=""

# Optional: restore the live peraturan embed after a database loss.
# Developer Mode → right-click the rules channel → Copy Channel ID.
# Message id defaults to the recovered snowflake 1529821999977857036.
RULES_MESSAGE_CHANNEL_ID=""
RULES_MESSAGE_ID="1529821999977857036"
